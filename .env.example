# Copia este archivo como .env SOLO para pruebas locales. Nunca subas .env a GitHub.
# En Vercel, configura estas variables en Settings > Environment Variables.

# Obligatoria: tu clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: modelo a usar
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional pero recomendado: dominio exacto de tu sitio, ej. https://asistente-4life.vercel.app
ALLOWED_ORIGIN=

# Opcional: preguntas por minuto por visitante
RATE_LIMIT_PER_MIN=10

# Opcional: clave SECRETA de Stripe para cobrar con tarjeta (dashboard.stripe.com > Developers > API keys).
# Usa sk_test_... para pruebas y sk_live_... solo cuando todo funcione. Nunca la pongas en el código.
STRIPE_SECRET_KEY=
